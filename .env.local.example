# Google Sheets service account — paste the ENTIRE JSON key file content as the value
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Sheet ID for SMS Drafts
GOOGLE_SHEETS_SHEET_ID=1Fnr0Bk2JfRWLxhh-Jh0Mp_o387O5mVV0e_3QS_81kng

# n8n webhook base URL — still used for approve/dismiss/review (no trailing slash)
NEXT_PUBLIC_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# Webhook URL for flagged review submissions
NEXT_PUBLIC_REVIEW_WEBHOOK_URL=https://your-n8n-instance.com/webhook/sms-review

# Set to "false" to use live data instead of mock data
NEXT_PUBLIC_USE_MOCK_DATA=true
